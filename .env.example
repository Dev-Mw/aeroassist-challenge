APP_ENV=local
APP_VERSION=1.0.0
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
TOOL_BACKEND=mcp
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=global
# Update before 2026-10-20; keep this configurable.
GENAI_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=512
RAG_TOP_K=3
RAG_MIN_SCORE=0.08
LOG_LEVEL=INFO


# Maximum simultaneous /v1/chat requests per API worker
MAX_CONCURRENT_CHATS=8
# End-to-end MCP stdio call timeout, including server startup
MCP_TIMEOUT_SECONDS=10
